# Server Configuration
PROJECT_NAME="AI Smart Pothole Detection and Reporting"
DEBUG=True
API_V1_STR="/api"

# Security
SECRET_KEY="generate-a-strong-secret-key-for-jwt-signing"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# 1. CLOUD DATABASE CONFIGURATION (Neon / Supabase / AWS RDS / PostgreSQL)
# ==============================================================================
# For Neon.tech: postgresql://[user]:[password]@[endpoint].neon.tech/pothole_db?sslmode=require
# For Supabase: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require
# For Local Dev: sqlite:///./potholes_dev.db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pothole_db"

# ==============================================================================
# 2. CLOUD OBJECT STORAGE CONFIGURATION (Cloudflare R2 / AWS S3 / Supabase)
# ==============================================================================
# STORAGE_BACKEND options: "local" (saves to backend/uploads/) or "s3" (saves to cloud bucket)
STORAGE_BACKEND="local"

# Cloud S3 / Cloudflare R2 / Supabase Storage credentials
S3_BUCKET_NAME="pothole-detection-images"
S3_ENDPOINT_URL=""                  # Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com | AWS S3: leave empty
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION_NAME="us-east-1"
S3_PUBLIC_DOMAIN=""                 # Optional public CDN domain, e.g. https://pub-xyz.r2.dev

# Storage Limits
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# AI / YOLO Model Configuration
YOLO_MODEL_PATH="models/pothole_yolov8.pt"
POTHOLE_CONFIDENCE_THRESHOLD=0.30

# Deduplication Configuration
DUPLICATE_RADIUS_METERS=25.0

# Initial Admin Seeding (Used by scripts/seed_admin.py)
ADMIN_EMAIL="admin@roads.gov"
ADMIN_PASSWORD="AdminPass123!"
ADMIN_NAME="Road Safety Administrator"
